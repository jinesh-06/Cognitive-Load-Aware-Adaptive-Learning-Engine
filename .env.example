# ============================================
# Backend (Render) Environment Variables
# ============================================

# Google Gemini API Key (required for LLM features)
GEMINI_API_KEY=your_gemini_api_key_here

# Node environment
NODE_ENV=production

# Server port (automatically set by Render)
# PORT=3000

# ============================================
# Frontend (Vercel) Environment Variables
# ============================================

# API endpoint URL - Set this in Vercel to your Render backend URL
# Example: https://your-app-name.onrender.com
VITE_API_URL=https://your-render-backend-url.onrender.com

# ============================================
# OAuth 2.0 Authentication (Google, GitHub, LinkedIn)
# ============================================

# Google OAuth (https://console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# GitHub OAuth (https://github.com/settings/developers -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# LinkedIn OAuth (https://www.linkedin.com/developers -> OpenID Connect)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# ============================================
# Firebase Authentication (https://console.firebase.google.com)
# ============================================

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id


